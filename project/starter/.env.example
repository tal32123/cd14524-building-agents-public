# Required for OpenAI Chat Completions and ChromaDB embeddings
OPENAI_API_KEY=

# Optional: OpenAI API base URL. Set to https://openai.vocareum.com/v1 if using a
# Udacity Vocareum proxy key (voc-...). Leave blank to use default api.openai.com.
OPENAI_BASE_URL=

# Optional — falls back to OPENAI_API_KEY in not set
CHROMA_OPENAI_API_KEY=

# Required for game_web_search tool (Tavily)
TAVILY_API_KEY=
